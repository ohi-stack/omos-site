# OMOS / OneGodian Platform — import.env
# Generated 2026-09-16
# Safe import template: real credentials are intentionally NOT embedded.
# Replace every __SET_*__ placeholder in the target secret/environment manager.

# Runtime
NODE_ENV=production
PORT=3000

# Versioning / Deployment Provenance
OMOS_VERSION=1.1.0
OMOS_BUILD_SHA=__SET_DEPLOYED_GIT_SHA__

# Canonical URLs
OMOS_CANONICAL_HOST=https://omos.onegodian.com
OMOS_PUBLIC_URL=https://omos.onegodian.com
ONEGODIAN_ORG_URL=https://onegodian.org
ONEGODIAN_PUBLIC_URL=https://onegodian.org
ONEGODIAN_STORE_URL=https://onegodian.com
ONEGODIAN_COMMERCE_URL=https://onegodian.com
ONEGODIAN_APP_URL=https://app.onegodian.com
ONEGODIAN_CONSOLE_URL=https://app.onegodian.com
ONEGODIAN_UNIVERSITY_URL=https://u.onegodian.org
ONEGODIAN_GALAXY_URL=https://galaxy.onegodian.com
ONEGODIAN_ODEFI_URL=https://odefi.onegodian.com
ONEGODIAN_CAPITAL_URL=https://capital.onegodian.com
QUANTUMOHI_URL=https://quantumohi.com
OMOS_WORDPRESS_URL=https://omos.onegodian.org

# OMOS Runtime Access
OMOS_API_KEYS=__SET_OMOS_API_KEYS__

# Durable PostgreSQL Decision Record Storage
DATABASE_URL=__SET_POSTGRES_DATABASE_URL__
OMOS_DB_SSL=true
OMOS_DB_POOL_MAX=5
OMOS_REQUIRE_DURABLE_DB=true
OMOS_ALLOW_MEMORY_PERSISTENCE=false

# OpenAI / GPT-6 Astra
OPENAI_API_KEY=__SET_OPENAI_API_KEY__
OPENAI_MODEL=gpt-6-astra
OPENAI_ASTRA_MODEL=gpt-6-astra
OPENAI_ASTRA_REASONING_EFFORT=high
OMOS_ASTRA_WEB_SEARCH=true
OMOS_ASTRA_FILE_SEARCH=true
OMOS_ASTRA_CODE_INTERPRETER=true
OMOS_ASTRA_COMPUTER_USE=true
OMOS_ASTRA_HOSTED_SHELL=true
OMOS_ASTRA_MCP=true
OMOS_ASTRA_REQUIRE_HUMAN_APPROVAL=true
GITHUB_TOKEN=__SET_GITHUB_FINE_GRAINED_PAT__

# Anthropic / Claude
ANTHROPIC_API_KEY=__SET_ANTHROPIC_API_KEY__
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini
GEMINI_API_KEY=__SET_GEMINI_API_KEY__
GEMINI_MODEL=gemini-2.5-pro

# xAI / Grok
XAI_API_KEY=__SET_XAI_API_KEY__
XAI_MODEL=grok-4

# OneGodian MCP Standard / Connection & Adaptation Layer
OMOS_MCP_CONNECTIONS_JSON=[]

# WordPress / OMOS Bridge
OMOS_WP_PLUGIN_SLUG=omos-core-tools
OMOS_WP_PLUGIN_VERSION=1.4.0
OMOS_BRIDGE_STATUS=repository-implemented
ONEGODIAN_ORG_PLUGIN_TARGET=true
ONEGODIAN_COM_PLUGIN_TARGET=true
QUANTUMOHI_PLUGIN_TARGET=true
ONEGODIAN_UNIVERSITY_PLUGIN_TARGET=true
OMOS_WORDPRESS_PLUGIN_TARGET=true
OMOS_BRIDGE_API_KEY=__SET_OMOS_BRIDGE_API_KEY__

# ACC — Agent Command Console
ACC_API_URL=https://acc.onegodian.com
ACC_API_KEY=__SET_ACC_API_KEY__

# QR-V / Verification
QRV_VERIFY_URL=__SET_QRV_VERIFY_URL__
QRV_API_KEY=__SET_QRV_API_KEY__

# OBP-1
OBP_NODE_URL=https://obp1.onegodian.org

# Stripe / Commerce
STRIPE_PUBLISHABLE_KEY=__SET_STRIPE_PUBLISHABLE_KEY__

# Analytics / Conversion Tracking
OMOS_ANALYTICS_PROVIDER=ga4
OMOS_GA4_MEASUREMENT_ID=__SET_GA4_MEASUREMENT_ID__
OMOS_CONVERSION_STORE_CATEGORY=/product-category/omos/

# Compliance / Site Identity
OMOS_LEGAL_DATE_AUTHORITY=Gregorian
SITE_NAME=OMOS — OneGodian Metaphysical Operating System
SITE_DESCRIPTION=Public node site and documentation layer for OMOS.OneGodian.com.
