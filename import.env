# OMOS.OneGodian.com - import.env
# Safe import template. This file contains no live secrets.
# Replace every REPLACE_* value in the secure hosting environment.
# Do not commit a populated production copy containing credentials.

# 1) CORE RUNTIME
NODE_ENV=production
PORT=3000
OMOS_VERSION=1.1.0
OMOS_BUILD_SHA=REPLACE_WITH_EXACT_DEPLOYED_GIT_SHA

# 2) CANONICAL URLS
OMOS_CANONICAL_HOST=https://omos.onegodian.com
OMOS_PUBLIC_URL=https://omos.onegodian.com
ONEGODIAN_ORG_URL=https://onegodian.org
ONEGODIAN_PUBLIC_URL=https://onegodian.org
ONEGODIAN_STORE_URL=https://onegodian.com
ONEGODIAN_COMMERCE_URL=https://onegodian.com
ONEGODIAN_APP_URL=https://app.onegodian.com
ONEGODIAN_CONSOLE_URL=https://app.onegodian.com
ONEGODIAN_UNIVERSITY_URL=https://u.onegodian.org
ONEGODIAN_GALAXY_URL=https://galaxy.onegodian.com
# Legacy variable retained for compatibility; ODeFi is the canonical digital-finance node.
ONEGODIAN_CAPITAL_URL=https://odefi.onegodian.com
ONEGODIAN_ODEFI_URL=https://odefi.onegodian.com
QUANTUMOHI_URL=https://quantumohi.com

# 3) OMOS API ACCESS / OWNERSHIP
# Expected production structure: owner-id:<sha256-key-hash>:plan
OMOS_API_KEYS=REPLACE_WITH_PRODUCTION_OWNER_KEY_RECORDS

# 4) DURABLE POSTGRESQL DECISION RECORD STORAGE
DATABASE_URL=REPLACE_WITH_PRODUCTION_POSTGRESQL_URL
OMOS_DB_SSL=true
OMOS_DB_POOL_MAX=5
OMOS_REQUIRE_DURABLE_DB=true
OMOS_ALLOW_MEMORY_PERSISTENCE=false

# 5) OPENAI / GPT-6 ASTRA
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-6-astra
OPENAI_ASTRA_MODEL=gpt-6-astra
OPENAI_ASTRA_REASONING_EFFORT=medium
OMOS_ASTRA_WEB_SEARCH=false
OMOS_ASTRA_FILE_SEARCH=false
OMOS_ASTRA_CODE_INTERPRETER=false
OMOS_ASTRA_COMPUTER_USE=false
OMOS_ASTRA_HOSTED_SHELL=false
OMOS_ASTRA_MCP=false
OMOS_ASTRA_REQUIRE_HUMAN_APPROVAL=true

# 6) ANTHROPIC
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 7) GOOGLE GEMINI
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-pro

# 8) XAI / GROK
XAI_API_KEY=REPLACE_WITH_XAI_API_KEY
XAI_MODEL=grok-4

# 9) ONEGODIAN MCP STANDARD / CONNECTION & ADAPTATION LAYER
OMOS_MCP_CONNECTIONS_JSON=[]

# 10) WORDPRESS / OMOS BRIDGE
OMOS_WP_PLUGIN_SLUG=omos-core-tools
OMOS_WP_PLUGIN_VERSION=1.3.0
OMOS_BRIDGE_STATUS=planned
ONEGODIAN_ORG_PLUGIN_TARGET=true
ONEGODIAN_COM_PLUGIN_TARGET=true
QUANTUMOHI_PLUGIN_TARGET=true

# 11) ACTIVE / OPTIONAL ECOSYSTEM INTEGRATIONS
ACC_API_URL=https://acc.onegodian.com
ACC_API_KEY=REPLACE_WITH_ACC_API_KEY
QRV_VERIFY_URL=https://qrv.network
QRV_API_KEY=REPLACE_WITH_QRV_API_KEY
OBP_NODE_URL=REPLACE_WITH_OBP_NODE_URL
STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_STRIPE_PUBLISHABLE_KEY

# 12) RESERVED CONNECTOR VARIABLES
# Architecture-ready placeholders. Some are not yet consumed by current omos-site main.
OLLM_API_URL=REPLACE_WITH_OLLM_API_URL
OLLM_API_KEY=REPLACE_WITH_OLLM_API_KEY
OCP_API_URL=REPLACE_WITH_OCP_API_URL
OCP_API_KEY=REPLACE_WITH_OCP_API_KEY
OEG_API_URL=REPLACE_WITH_OEG_API_URL
OEG_API_KEY=REPLACE_WITH_OEG_API_KEY
ODIN_API_URL=REPLACE_WITH_ODIN_API_URL
ODIN_API_KEY=REPLACE_WITH_ODIN_API_KEY
OBP_API_KEY=REPLACE_WITH_OBP_API_KEY
ONEGODIAN_TIME_API_URL=https://time.onegodian.org
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET

# 13) RELEASE / LIVE PRODUCTION VERIFICATION
OMOS_BASE_URL=https://omos.onegodian.com
OMOS_EXPECTED_VERSION=1.1.0
OMOS_EXPECTED_SHA=REPLACE_WITH_EXACT_DEPLOYED_GIT_SHA

# 14) ANALYTICS / CONVERSION
OMOS_ANALYTICS_PROVIDER=ga4
OMOS_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
OMOS_CONVERSION_STORE_CATEGORY=/product-category/omos/

# 15) COMPLIANCE / SITE METADATA
OMOS_LEGAL_DATE_AUTHORITY=Gregorian
SITE_NAME="OMOS - OneGodian Metaphysical Operating System"
SITE_DESCRIPTION="Public node site and documentation layer for OMOS.OneGodian.com."
